{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "my-extension",
  "name": {
    "de": "Meine Erweiterung",
    "en": "My Extension"
  },
  "description": {
    "de": "Startpunkt für eigene Hostwerk-Erweiterungen: Seite, Kachel, Einstellungen und Übersetzungen.",
    "en": "Starting point for your own Hostwerk extensions: page, tile, settings and translations."
  },
  "version": "1.3.0",
  "author": "Your name",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-template",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#7c5cff",
  "category": "developer",
  "hostwerk": ">=2.11.0",
  "permissions": [
    "read:services",
    "storage"
  ],
  "page": {
    "title": {
      "de": "Meine Erweiterung",
      "en": "My Extension"
    },
    "icon": "puzzle",
    "file": "page/index.html",
    "description": {
      "de": "Startpunkt für eigene Hostwerk-Erweiterungen: Seite, Kachel, Einstellungen und Übersetzungen.",
      "en": "Starting point for your own Hostwerk extensions: page, tile, settings and translations."
    },
    "nav": {
      "group": "develop"
    }
  },
  "widget": {
    "title": {
      "de": "Meine Kachel",
      "en": "My tile"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "settings": [
    {
      "key": "greeting",
      "type": "text",
      "label": {
        "de": "Begrüßung",
        "en": "Greeting"
      },
      "default": ""
    },
    {
      "key": "onlyRunning",
      "type": "switch",
      "label": {
        "de": "Nur laufende Dienste",
        "en": "Only running services"
      },
      "default": false
    }
  ],
  "settingsTab": "extensions",
  "contributes": {
    "new": [
      {
        "id": "count",
        "title": {
          "de": "Klick zählen",
          "en": "Count a click"
        },
        "icon": "sparkles"
      }
    ],
    "shortcuts": [
      {
        "id": "open",
        "title": {
          "de": "Meine Erweiterung öffnen",
          "en": "Open My Extension"
        },
        "keys": "ctrl+alt+m"
      }
    ]
  },
  "allowExtensions": {
    "my-addon": [
      "tabs",
      "actions",
      "settings"
    ],
    "*": [
      "tabs"
    ]
  }
}
